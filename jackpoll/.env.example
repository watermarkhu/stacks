# Copy to .env (gitignored via *.env) and replace every CHANGE_ME:
#   openssl rand -hex 24


APP_BASE_URL=https://jackpoll.watermarkhu.nl
CORS_ORIGINS=https://jackpoll.watermarkhu.nl
KEYCLOAK_HOSTNAME=https://jackpoll-auth.watermarkhu.nl

DB_PASSWORD=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
SURVEY_SPAM_SECRET=CHANGE_ME
EMAIL_CODE_SECRET=CHANGE_ME
SURVEY_MAIL_UNSUBSCRIBE_SECRET=CHANGE_ME

# Optional: close sign-ups (no real SMTP configured, so verification mail only reaches the internal Mailpit)
ALLOW_PUBLIC_REGISTRATION=true
# LEGAL_ENTITY=
# LEGAL_IMPRINT_FILE=/legal/imprint.md

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME
