{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'docker:pinDigests'],

  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s+(?:ARG|ENV) [A-Z_]+?=(?<currentValue>[^\\s]+)',
      ],
    },
  ],

  packageRules: [
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pinDigest'],
      automerge: true,
    },
    {
      matchManagers: ['docker-compose', 'dockerfile'],
      matchUpdateTypes: ['major'],
      automerge: false,
      labels: ['major-update'],
    },
    {
      matchFileNames: ['openchamber-devbox/**'],
      matchManagers: ['mise', 'custom.regex'],
      groupName: 'openchamber devbox toolchain',
    },
    {
      matchFileNames: ['openchamber-devbox/**'],
      matchManagers: ['mise'],
      matchPackageNames: ['node'],
      matchUpdateTypes: ['major'],
      groupName: null,
      labels: ['major-update'],
    },
  ],
}
