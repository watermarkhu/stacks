# Copy to .env (git-ignored) and fill in.

# Required: password for the OpenChamber web UI.
OPENCHAMBER_UI_PASSWORD=change-me

# Host address the UI port binds to. Never 0.0.0.0.
#   127.0.0.1      -> only reachable through Traefik (openchamber.local.watermarkhu.nl)
#   100.x.y.z      -> your server's Tailscale IP, for direct VPN access
BIND_ADDR=127.0.0.1
# 3000 and 3001 are already used by ha-wa-bridge and dockhand.
HOST_PORT=3002

# Where your projects live on the host (mounted at /workspace).
WORKSPACE_DIR=/mnt/NVME/docker/openchamber/workspace

# Must match the host user that owns WORKSPACE_DIR: `id -u` / `id -g`.
# Changing these requires `docker compose up -d --build`.
UID=1000
GID=1000

# Written to the global git config on every start.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Optional provider keys for OpenCode (you can also log in with `opencode auth login`).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
